# Leave both of these empty to use the same address the page was opened from, on port 5000
# (works on this computer and on other devices on the same network, e.g. http://192.168.1.20:3001).
# VITE_API_PORT: the backend's port, if it is not 5000.
# VITE_API_URL: the full address of the API. Set this only when the backend is on another address,
# e.g. a hosted backend: https://normi-api.example.com/api
VITE_API_PORT=5000
# VITE_API_URL=
