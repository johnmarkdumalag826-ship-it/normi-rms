# Your MongoDB Atlas address. Use a database password with letters and numbers only.
# Keep the database name (normi_rms) before the question mark.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/normi_rms?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string
PORT=5000
CLIENT_URL=http://localhost:3000
