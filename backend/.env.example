# Your MongoDB Atlas address. Use a database password with letters and numbers only.
# Keep the database name (normi_rms) before the question mark.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/normi_rms?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string
PORT=5000
CLIENT_URL=http://localhost:3000

# Used to email a "forgot password" code. With Gmail: turn on 2-Step Verification, then create
# an App Password at https://myaccount.google.com/apppasswords and use it as EMAIL_PASS
# (not your normal Gmail password). EMAIL_FROM is optional; it defaults to EMAIL_USER.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your-address@gmail.com
EMAIL_PASS=your-16-character-app-password
EMAIL_FROM=your-address@gmail.com
